              { "name": "Content-Type", "value": "audio/mpeg" },
              { "name": "Cache-Control", "value": "public, max-age=86400" }
            ]
          }
        }
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Responder MP3 + CORS",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
